
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=7000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash 已弃用（批次11）：搜索 API 国内不可达且 key 为空，
# 图片改为本地映射表 + 磁盘缓存代理，见 app/planner/local_photo_table.py。
# Settings 里保留 unsplash_* 字段只为兼容旧 .env，没有任何代码读取，不需要配置。

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
# 后端也支持这个名称，和后训练脚本共用同一份 key
# AMAP_MAPS_API_KEY=your_amap_api_key_here

# 多候选 rerank（默认开启）
PLANNER_ENABLE_RERANK=1
PLANNER_RERANK_CANDIDATE_COUNT=3
PLANNER_RERANK_TEMPERATURE_STEP=0.08

# 思考模式开关：0=关闭(推荐,输出更稳更快) 1=开启(需自行放大 max_tokens)
# DeepSeek V4 默认开思考，思考 token 会占用 max_tokens 预算，
# 且思考模式下 temperature 无效（本项目靠它制造候选差异）。
PLANNER_THINKING=0

# === 成本与并发治理（批次8）===
# 限流开关：0 关闭（本地调试用），1 开启（推荐）
RATE_LIMIT_ENABLED=1
# 规划类接口额度：一次请求会触发 3 个候选的 LLM 调用，所以给得很小
RATE_LIMIT_PLAN_PER_MINUTE=6
RATE_LIMIT_PLAN_BURST=3
# 普通接口额度：图片、POI 搜索这类
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_DEFAULT_BURST=60
# 只有部署在反向代理后面时才设为 1，否则任何人都能靠伪造 X-Forwarded-For 绕过限流
RATE_LIMIT_TRUST_PROXY=0
# 同一时刻允许几个规划任务在跑（每个任务内部还有 3 路候选并行）
PLANNER_MAX_CONCURRENCY=2
