# 后端API地址；开发环境留空时走 Vite /api 代理
VITE_API_BASE_URL=

# 注意：前端只需要一个高德 key，就是下面的 VITE_AMAP_WEB_JS_KEY。
# 后端调 restapi 用的「Web服务」key 配在 backend/.env 的 AMAP_API_KEY，
# 两者不要混用（混用会报 USERKEY_PLAT_NOMATCH）。这里曾有一个
# VITE_AMAP_WEB_KEY，前端代码从不读取它，已删除以免误导。
# 高德地图Web端JS API Key（前端地图用，必须是「Web端(JS API)」类型）
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here
# 高德 JSAPI 安全密钥（2021-12-02 之后创建的 key 必填，与 JS key 同处申请）
VITE_AMAP_SECURITY_JS_CODE=
